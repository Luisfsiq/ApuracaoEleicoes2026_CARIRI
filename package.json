{
  "name": "apuracao-cariri-ocidental",
  "version": "1.1.0",
  "description": "Aplicativo desktop para consulta das apurações eleitorais do Cariri Ocidental.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "build": "electron-builder --win portable"
  },
  "dependencies": {
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^38.2.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "br.com.caririocidental.apuracao",
    "productName": "Apuração Cariri Ocidental",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "data/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ]
    }
  }
}
